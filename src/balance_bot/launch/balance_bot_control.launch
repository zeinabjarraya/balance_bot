<!-- Balance Bot Cascade Controller -->
<!-- ============================== -->

<launch>
 <param name="robot_description" command="$(find xacro)/xacro '$(find balance_bot)/urdf/balance_bot.urdf.xacro'" />
    <rosparam file="$(find balance_bot)/config/balance_bot_controllers.yaml" command="load"/>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
          output="screen"
          args="joint_state_controller left_wheel_effort_controller right_wheel_effort_controller"/>

   <node name="two_loop_balance_controller" pkg="balance_bot" type="pid_balance.py" output="screen" /> 

<node pkg="balance_bot" type="plot_balance_pid.py" name="plot_balance_pid" output="screen">
        <!-- optional overrides -->
        <param name="buffer_seconds" value="12.0"/>
        <param name="update_hz" value="15.0"/>
        <!-- topics if different -->
        <param name="imu_topic" value="/balance_bot/imu_data"/>
        <param name="left_topic" value="/left_wheel_effort_controller/command"/>
        <param name="right_topic" value="/right_wheel_effort_controller/command"/>
    </node>

</launch>
